# ShepherdOS API — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Database ────────────────────────────────────────────────
# Local development — replace USERNAME and PASSWORD with your PostgreSQL credentials
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/shepherdos_dev"

# ─── Auth ────────────────────────────────────────────────────
# Generate a strong random string for JWT signing.
# You can run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-this-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ─── Server ──────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────
# URL of your React frontend (Vite default)
FRONTEND_URL="http://localhost:3000"

# ─── Email (Member Portal invites & password resets) ──────────
# Any standard SMTP provider works — Gmail, SendGrid, Mailgun,
# Resend, Mailtrap (for testing), etc. If SMTP_HOST is left blank,
# emails are logged to the console instead of sent (dev fallback).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ShepherdOS <no-reply@example.org>"
